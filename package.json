{
  "name": "jarvis",
  "private": true,
  "version": "0.0.0",
  "description": "A browser voice assistant with an Iron Man holographic interface, driven by Claude Code through a small Node bridge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test",
    "postinstall": "node scripts/ensure-custom.mjs",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:writes": "node bridge/server.mjs --writes",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.331",
    "@anthropic-ai/sdk": "^0.115.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "ws": "^8.23.0",
    "zod": "^4.4.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.95.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
